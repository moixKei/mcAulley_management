<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Menú Principal - Sistema de Gestión Educativa</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .menu-card {
            transition: all 0.3s ease;
            border: none;
            border-radius: 15px;
            height: 100%;
            position: relative;
            overflow: hidden;
        }
        .menu-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.2);
        }
        .menu-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.6), transparent);
            transform: translateX(-100%);
            transition: transform 0.6s;
        }
        .menu-card:hover::before {
            transform: translateX(100%);
        }
        .menu-icon {
            font-size: 3.5rem;
            margin-bottom: 1.5rem;
            transition: transform 0.3s ease;
        }
        .menu-card:hover .menu-icon {
            transform: scale(1.1);
        }
        .feature-section {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 15px;
            color: white;
            position: relative;
            overflow: hidden;
        }
        .feature-section::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 1px, transparent 1px);
            background-size: 20px 20px;
            animation: float 20s infinite linear;
        }
        @keyframes float {
            0% { transform: translate(0, 0) rotate(0deg); }
            100% { transform: translate(-20px, -20px) rotate(360deg); }
        }
        .stats-badge {
            position: absolute;
            top: 15px;
            right: 15px;
            background: rgba(255,255,255,0.2);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 5px 12px;
            font-size: 0.8rem;
            font-weight: bold;
        }
        .quick-action-btn {
            transition: all 0.3s ease;
            border: 2px solid transparent;
        }
        .quick-action-btn:hover {
            border-color: rgba(255,255,255,0.5);
            transform: translateY(-2px);
        }
    </style>
</head>
<body>
    <!-- Navigation Bar Mejorada -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold" th:href="@{/}">
                <i class="fas fa-graduation-cap me-2"></i>
                EduManager Pro
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <div class="navbar-nav ms-auto">
                    <a class="nav-link active" th:href="@{/}"><i class="fas fa-home me-1"></i>Inicio</a>
                    <a class="nav-link" th:href="@{/dashboard}"><i class="fas fa-tachometer-alt me-1"></i>Dashboard</a>
                    <a class="nav-link" th:href="@{/cursos}"><i class="fas fa-book me-1"></i>Cursos</a>
                    <a class="nav-link" th:href="@{/alumnas}"><i class="fas fa-users me-1"></i>Alumnas</a>
                </div>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <!-- Header Mejorado -->
        <div class="row mb-5">
            <div class="col-12 text-center">
                <div class="mb-4">
                    <i class="fas fa-rocket fa-4x text-primary mb-3"></i>
                </div>
                <h1 class="display-4 fw-bold text-dark mb-3">
                    Panel de Control Principal
                </h1>
                <p class="lead text-muted">Sistema integral de gestión educativa - Seleccione el módulo a administrar</p>
                <div class="mt-4">
                    <span class="badge bg-primary me-2"><i class="fas fa-users me-1"></i> <span th:text="${totalAlumnas ?: '0'}">0</span> Alumnas</span>
                    <span class="badge bg-success me-2"><i class="fas fa-book me-1"></i> <span th:text="${totalCursos ?: '0'}">0</span> Cursos</span>
                    <span class="badge bg-info me-2"><i class="fas fa-calendar me-1"></i> <span th:text="${totalHorarios ?: '0'}">0</span> Horarios</span>
                    <span class="badge bg-warning"><i class="fas fa-user-graduate me-1"></i> <span th:text="${totalInscripciones ?: '0'}">0</span> Inscripciones</span>
                </div>
            </div>
        </div>

        <!-- Main Menu Grid Mejorado -->
        <div class="row g-4">
            <!-- Gestión de Alumnas -->
            <div class="col-md-6 col-lg-3">
                <a th:href="@{/alumnas}" class="text-decoration-none">
                    <div class="card menu-card text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                        <div class="stats-badge">
                            <i class="fas fa-user-plus me-1"></i> <span th:text="${nuevasAlumnas ?: '0'}">0</span>
                        </div>
                        <div class="card-body text-center p-4">
                            <div class="menu-icon">
                                <i class="fas fa-users"></i>
                            </div>
                            <h4>Gestión de Alumnas</h4>
                            <p class="mb-2 opacity-75">Administrar estudiantes y registros académicos</p>
                            <small class="opacity-75"><i class="fas fa-arrow-right me-1"></i> Acceder al módulo</small>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Gestión de Cursos -->
            <div class="col-md-6 col-lg-3">
                <a th:href="@{/cursos}" class="text-decoration-none">
                    <div class="card menu-card text-white" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                        <div class="stats-badge">
                            <i class="fas fa-play-circle me-1"></i> <span th:text="${cursosActivos ?: '0'}">0</span>
                        </div>
                        <div class="card-body text-center p-4">
                            <div class="menu-icon">
                                <i class="fas fa-book"></i>
                            </div>
                            <h4>Gestión de Cursos</h4>
                            <p class="mb-2 opacity-75">Crear y administrar programas académicos</p>
                            <small class="opacity-75"><i class="fas fa-arrow-right me-1"></i> Acceder al módulo</small>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Gestión de Horarios -->
            <div class="col-md-6 col-lg-3">
                <a th:href="@{/horarios}" class="text-decoration-none">
                    <div class="card menu-card text-white" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                        <div class="stats-badge">
                            <i class="fas fa-clock me-1"></i> <span th:text="${horariosActivos ?: '0'}">0</span>
                        </div>
                        <div class="card-body text-center p-4">
                            <div class="menu-icon">
                                <i class="fas fa-calendar-alt"></i>
                            </div>
                            <h4>Gestión de Horarios</h4>
                            <p class="mb-2 opacity-75">Programar clases y asignar aulas</p>
                            <small class="opacity-75"><i class="fas fa-arrow-right me-1"></i> Acceder al módulo</small>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Gestión de Inscripciones -->
            <div class="col-md-6 col-lg-3">
                <a th:href="@{/inscripciones}" class="text-decoration-none">
                    <div class="card menu-card text-white" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">
                        <div class="stats-badge">
                            <i class="fas fa-user-check me-1"></i> <span th:text="${inscripcionesHoy ?: '0'}">0</span>
                        </div>
                        <div class="card-body text-center p-4">
                            <div class="menu-icon">
                                <i class="fas fa-user-graduate"></i>
                            </div>
                            <h4>Inscripciones</h4>
                            <p class="mb-2 opacity-75">Gestionar matrículas y estados de pago</p>
                            <small class="opacity-75"><i class="fas fa-arrow-right me-1"></i> Acceder al módulo</small>
                        </div>
                    </div>
                </a>
            </div>
        </div>

        <!-- Quick Actions Mejoradas -->
        <div class="row mt-5">
            <div class="col-12">
                <h3 class="fw-bold mb-4"><i class="fas fa-bolt me-2"></i>Acciones Rápidas</h3>
                <div class="row g-3">
                    <div class="col-md-3">
                        <a th:href="@{/alumnas/nuevo}" class="text-decoration-none">
                            <div class="card quick-action-btn border-0 bg-light h-100">
                                <div class="card-body text-center p-4">
                                    <i class="fas fa-user-plus fa-2x text-primary mb-3"></i>
                                    <h6 class="fw-bold">Nueva Alumna</h6>
                                    <small class="text-muted">Registrar nueva estudiante</small>
                                </div>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-3">
                        <a th:href="@{/cursos/nuevo}" class="text-decoration-none">
                            <div class="card quick-action-btn border-0 bg-light h-100">
                                <div class="card-body text-center p-4">
                                    <i class="fas fa-plus-circle fa-2x text-success mb-3"></i>
                                    <h6 class="fw-bold">Nuevo Curso</h6>
                                    <small class="text-muted">Crear nuevo programa</small>
                                </div>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-3">
                        <a th:href="@{/horarios/nuevo}" class="text-decoration-none">
                            <div class="card quick-action-btn border-0 bg-light h-100">
                                <div class="card-body text-center p-4">
                                    <i class="fas fa-clock fa-2x text-info mb-3"></i>
                                    <h6 class="fw-bold">Nuevo Horario</h6>
                                    <small class="text-muted">Programar clase</small>
                                </div>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-3">
                        <a th:href="@{/inscripciones/nuevo}" class="text-decoration-none">
                            <div class="card quick-action-btn border-0 bg-light h-100">
                                <div class="card-body text-center p-4">
                                    <i class="fas fa-user-check fa-2x text-warning mb-3"></i>
                                    <h6 class="fw-bold">Nueva Inscripción</h6>
                                    <small class="text-muted">Matricular alumna</small>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Feature Section Mejorada -->
        <div class="feature-section p-5 mt-5 position-relative">
            <div class="row align-items-center position-relative z-1">
                <div class="col-md-8">
                    <h2 class="fw-bold mb-3">¿Necesitas asistencia?</h2>
                    <p class="lead mb-0">Nuestro equipo de soporte está disponible 24/7 para resolver tus dudas y garantizar el óptimo funcionamiento del sistema.</p>
                </div>
                <div class="col-md-4 text-end">
                    <button class="btn btn-light btn-lg quick-action-btn px-4">
                        <i class="fas fa-headset me-2"></i>Soporte
                    </button>
                </div>
            </div>
        </div>

        <!-- System Status -->
        <div class="row mt-5">
            <div class="col-12">
                <div class="card border-0 bg-light">
                    <div class="card-body">
                        <h5 class="fw-bold mb-3"><i class="fas fa-server me-2"></i>Estado del Sistema</h5>
                        <div class="row text-center">
                            <div class="col-md-3">
                                <div class="p-3">
                                    <i class="fas fa-database fa-2x text-success mb-2"></i>
                                    <h6 class="fw-bold">Base de Datos</h6>
                                    <span class="badge bg-success">En Línea</span>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="p-3">
                                    <i class="fas fa-shield-alt fa-2x text-success mb-2"></i>
                                    <h6 class="fw-bold">Seguridad</h6>
                                    <span class="badge bg-success">Activa</span>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="p-3">
                                    <i class="fas fa-sync fa-2x text-info mb-2"></i>
                                    <h6 class="fw-bold">Sincronización</h6>
                                    <span class="badge bg-info">Actualizado</span>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="p-3">
                                    <i class="fas fa-bell fa-2x text-warning mb-2"></i>
                                    <h6 class="fw-bold">Notificaciones</h6>
                                    <span class="badge bg-warning">5 Pendientes</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer Mejorado -->
    <footer class="bg-dark text-white mt-5 py-4">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h5 class="fw-bold"><i class="fas fa-graduation-cap me-2"></i>EduManager Pro</h5>
                    <p class="mb-0 opacity-75">Plataforma integral para la gestión académica - Versión 2.1</p>
                </div>
                <div class="col-md-6 text-end">
                    <div class="d-flex justify-content-end gap-3">
                        <small class="opacity-75"><i class="fas fa-user me-1"></i> Usuario: Admin</small>
                        <small class="opacity-75"><i class="fas fa-clock me-1"></i> <span id="current-time"></span></small>
                    </div>
                    <p class="mb-0 opacity-75">&copy; 2024 Todos los derechos reservados</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Actualizar hora actual
        function updateTime() {
            const now = new Date();
            document.getElementById('current-time').textContent = now.toLocaleTimeString();
        }
        setInterval(updateTime, 1000);
        updateTime();

        // Efectos adicionales
        document.addEventListener('DOMContentLoaded', function() {
            // Animación de entrada para las tarjetas
            const cards = document.querySelectorAll('.menu-card');
            cards.forEach((card, index) => {
                card.style.opacity = '0';
                card.style.transform = 'translateY(20px)';
                setTimeout(() => {
                    card.style.transition = 'all 0.6s ease';
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                }, index * 100);
            });
        });
    </script>
</body>
</html>