<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de Horarios - McAulley</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary-color: #4361ee;
            --secondary-color: #3f37c9;
            --success-color: #4cc9f0;
            --warning-color: #f72585;
            --info-color: #4895ef;
        }
        
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        .container {
            max-width: 1400px;
        }
        
        /* Header Styles */
        .page-header {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            color: white;
            border-radius: 15px;
            padding: 2rem;
            margin-bottom: 2rem;
            box-shadow: 0 10px 30px rgba(67, 97, 238, 0.3);
        }
        
        .page-header h1 {
            font-weight: 700;
            margin-bottom: 0.5rem;
            font-size: 2.5rem;
        }
        
        .stats-text {
            font-size: 1.1rem;
            opacity: 0.9;
        }
        
        /* Card Styles */
        .card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
            margin-bottom: 1.5rem;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            overflow: hidden;
        }
        
        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        }
        
        .card-header {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            border-bottom: 2px solid #e9ecef;
            border-radius: 15px 15px 0 0 !important;
            padding: 1.25rem 1.5rem;
            font-weight: 600;
        }
        
        .card-header h5 {
            margin: 0;
            color: var(--primary-color);
        }
        
        /* Table Styles */
        .table-container {
            border-radius: 15px;
            overflow: hidden;
        }
        
        .table {
            margin: 0;
        }
        
        .table thead th {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            color: white;
            border: none;
            padding: 1rem 1.5rem;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 0.5px;
        }
        
        .table tbody tr {
            transition: all 0.3s ease;
            border-bottom: 1px solid #f1f3f4;
        }
        
        .table tbody tr:hover {
            background-color: #f8f9fa;
            transform: scale(1.01);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }
        
        .table tbody td {
            padding: 1.25rem 1.5rem;
            vertical-align: middle;
            border: none;
        }
        
        /* Badge Styles */
        .badge {
            border-radius: 20px;
            padding: 0.5rem 1rem;
            font-weight: 600;
            font-size: 0.75rem;
        }
        
        .badge-success {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        }
        
        .badge-secondary {
            background: linear-gradient(135deg, #6b7280 0%, #4b5563 100%);
        }
        
        .badge-info {
            background: linear-gradient(135deg, var(--info-color) 0%, #2563eb 100%);
        }
        
        .badge-primary {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
        }
        
        .badge-warning {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        }
        
        .badge-danger {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        }
        
        /* Button Styles */
        .btn-custom {
            border-radius: 10px;
            font-weight: 600;
            padding: 0.75rem 1.5rem;
            transition: all 0.3s ease;
            border: none;
        }
        
        .btn-success {
            background: linear-gradient(135deg, #4ade80 0%, #22c55e 100%);
        }
        
        .btn-secondary {
            background: linear-gradient(135deg, #6b7280 0%, #4b5563 100%);
            color: white;
        }
        
        /* Button Group Styles */
        .btn-group-sm > .btn {
            border-radius: 8px;
            margin: 0 2px;
            padding: 0.5rem 0.75rem;
            transition: all 0.3s ease;
        }
        
        .btn-info {
            background: linear-gradient(135deg, var(--info-color) 0%, #2563eb 100%);
            color: white;
            border: none;
        }
        
        .btn-danger {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            color: white;
            border: none;
        }
        
        .btn-info:hover, .btn-danger:hover {
            transform: translateY(-2px) scale(1.05);
        }
        
        /* Alert Styles */
        .alert {
            border: none;
            border-radius: 12px;
            padding: 1rem 1.5rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        }
        
        .alert-success {
            background: linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%);
            color: #065f46;
            border-left: 4px solid #10b981;
        }
        
        .alert-danger {
            background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
            color: #991b1b;
            border-left: 4px solid #ef4444;
        }
        
        .alert-info {
            background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
            color: #1e40af;
            border-left: 4px solid var(--info-color);
        }
        
        /* Day Badge Styles */
        .day-badge {
            min-width: 80px;
            text-align: center;
        }
        
        .time-badge {
            font-family: 'Courier New', monospace;
            font-weight: 700;
        }
        
        /* Course Info */
        .course-info {
            background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
            border-left: 4px solid var(--info-color);
        }
        
        /* Empty State */
        .empty-state {
            padding: 4rem 2rem;
            text-align: center;
        }
        
        .empty-state i {
            font-size: 4rem;
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 1.5rem;
        }
        
        /* Responsive */
        @media (max-width: 768px) {
            .page-header {
                padding: 1.5rem;
                text-align: center;
            }
            
            .page-header h1 {
                font-size: 2rem;
            }
            
            .btn-group {
                flex-direction: column;
                gap: 0.5rem;
            }
            
            .btn-group .btn {
                margin: 0.25rem 0;
            }
            
            .table-responsive {
                font-size: 0.875rem;
            }
        }
    </style>
</head>
<body>
    <div class="container mt-4">
        <!-- Header -->
        <div class="page-header">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1>
                        <i class="fas fa-calendar-alt me-2"></i>
                        Gestión de Horarios
                    </h1>
                    <p class="stats-text mb-0">
                        Administra los horarios de los cursos del sistema
                    </p>
                </div>
                <div class="btn-group">
                    <a th:href="@{/cursos}" class="btn btn-light btn-custom me-2">
                        <i class="fas fa-book me-2"></i>Ver Cursos
                    </a>
                    <a th:href="@{/horarios/nuevo}" class="btn btn-success btn-custom">
                        <i class="fas fa-plus me-2"></i>Nuevo Horario
                    </a>
                </div>
            </div>
        </div>

        <!-- Alertas -->
        <div th:if="${success}" class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
            <i class="fas fa-check-circle me-2 fs-5"></i>
            <div class="flex-grow-1">
                <span th:text="${success}"></span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
        
        <div th:if="${error}" class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
            <i class="fas fa-exclamation-triangle me-2 fs-5"></i>
            <div class="flex-grow-1">
                <span th:text="${error}"></span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>

        <!-- Información del Curso (si se está filtrando por curso) -->
        <div th:if="${curso != null}" class="card course-info">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="text-info mb-1">
                            <i class="fas fa-book me-2"></i>
                            Horarios del Curso
                        </h5>
                        <p class="mb-0">
                            <strong th:text="${curso.nombre}"></strong>
                            <span class="text-muted ms-2">| ID: <code th:text="${curso.idCurso}"></code></span>
                        </p>
                    </div>
                    <a th:href="@{/horarios}" class="btn btn-outline-info btn-sm">
                        <i class="fas fa-times me-1"></i>Quitar Filtro
                    </a>
                </div>
            </div>
        </div>

        <!-- Estadísticas Rápidas -->
        <div class="row mb-4" th:if="${!horarios.empty}">
            <div class="col-md-3 mb-3">
                <div class="card text-white bg-primary">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h4 class="fw-bold mb-0" th:text="${horarios.size()}">0</h4>
                                <p class="mb-0 opacity-75">Total Horarios</p>
                            </div>
                            <i class="fas fa-calendar fa-2x opacity-75"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="card text-white bg-success">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h4 class="fw-bold mb-0" th:text="${horarios.?[activo == true].size()}">0</h4>
                                <p class="mb-0 opacity-75">Horarios Activos</p>
                            </div>
                            <i class="fas fa-check-circle fa-2x opacity-75"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="card text-white bg-info">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h4 class="fw-bold mb-0" th:text="${#sets.size(#lists.distinct(horarios.![curso]))}">0</h4>
                                <p class="mb-0 opacity-75">Cursos con Horario</p>
                            </div>
                            <i class="fas fa-book-open fa-2x opacity-75"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="card text-white bg-warning">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h4 class="fw-bold mb-0" th:text="${horarios.?[aula != null and !aula.empty].size()}">0</h4>
                                <p class="mb-0 opacity-75">Aulas Asignadas</p>
                            </div>
                            <i class="fas fa-door-open fa-2x opacity-75"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabla de Horarios -->
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="fas fa-list me-2"></i>
                    Lista de Horarios
                    <span th:if="${curso != null}" class="badge bg-info ms-2">
                        Filtrado por: <span th:text="${curso.nombre}"></span>
                    </span>
                </h5>
                <span class="badge bg-secondary" th:text="'Mostrando: ' + ${horarios.size()}"></span>
            </div>
            <div class="card-body p-0 table-container">
                <div th:if="${horarios.empty}" class="empty-state">
                    <i class="fas fa-calendar-times"></i>
                    <h5 class="text-muted">No se encontraron horarios</h5>
                    <p th:if="${curso != null}" class="text-muted">
                        No hay horarios registrados para el curso "<span th:text="${curso.nombre}"></span>"
                    </p>
                    <p th:unless="${curso != null}" class="text-muted">
                        No hay horarios registrados en el sistema
                    </p>
                    <a th:href="@{/horarios/nuevo}" class="btn btn-primary btn-custom mt-3">
                        <i class="fas fa-plus me-2"></i>Crear Primer Horario
                    </a>
                </div>

                <div th:unless="${horarios.empty}" class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Curso</th>
                                <th>Día</th>
                                <th>Horario</th>
                                <th>Duración</th>
                                <th>Aula</th>
                                <th>Estado</th>
                                <th width="150">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr th:each="horario : ${horarios}">
                                <td>
                                    <span class="text-muted small" th:text="${horario.idHorario}"></span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark" th:text="${horario.curso.nombre}"></div>
                                    <small class="text-muted">
                                        ID: <code th:text="${horario.curso.idCurso}"></code>
                                    </small>
                                </td>
                                <td>
                                    <span class="badge day-badge" 
                                          th:classappend="${horario.diaSemana == 'Lunes'} ? 'bg-primary' :
                                                          (${horario.diaSemana == 'Martes'} ? 'bg-success' :
                                                          (${horario.diaSemana == 'Miércoles'} ? 'bg-info' :
                                                          (${horario.diaSemana == 'Jueves'} ? 'bg-warning' :
                                                          (${horario.diaSemana == 'Viernes'} ? 'bg-purple' :
                                                          (${horario.diaSemana == 'Sábado'} ? 'bg-orange' : 'bg-secondary')))))}"
                                          th:text="${horario.diaSemana}">
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex flex-column">
                                        <span class="badge bg-success time-badge mb-1" 
                                              th:text="${#temporals.format(horario.horaInicio, 'HH:mm')}">
                                        </span>
                                        <span class="badge bg-danger time-badge" 
                                              th:text="${#temporals.format(horario.horaFin, 'HH:mm')}">
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark">
                                        <span th:text="${#temporals.format(horario.horaFin, 'HH:mm')}"></span>
                                    </span>
                                </td>
                                <td>
                                    <span th:if="${horario.aula}" class="fw-semibold" th:text="${horario.aula}"></span>
                                    <span th:unless="${horario.aula}" class="text-muted">Sin asignar</span>
                                </td>
                                <td>
                                    <span th:if="${horario.activo}" class="badge bg-success">
                                        <i class="fas fa-check me-1"></i> Activo
                                    </span>
                                    <span th:unless="${horario.activo}" class="badge bg-secondary">
                                        <i class="fas fa-times me-1"></i> Inactivo
                                    </span>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a th:href="@{/horarios/curso/{id}(id=${horario.curso.idCurso})}" 
                                           class="btn btn-info" title="Ver horarios del curso">
                                            <i class="fas fa-list"></i>
                                        </a>
                                        <a th:href="@{/horarios/editar/{id}(id=${horario.idHorario})}" 
                                           class="btn btn-warning" title="Editar horario">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button type="button" 
                                                class="btn btn-danger" 
                                                title="Eliminar horario"
                                                data-bs-toggle="modal" 
                                                th:attr="data-bs-target='#modalEliminar' + ${horario.idHorario}">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>

                                    <!-- Modal de confirmación para eliminar -->
                                    <div class="modal fade" th:id="'modalEliminar' + ${horario.idHorario}" tabindex="-1">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title text-danger">
                                                        <i class="fas fa-exclamation-triangle me-2"></i>
                                                        Confirmar Eliminación
                                                    </h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p>¿Está seguro de que desea eliminar el siguiente horario?</p>
                                                    <div class="alert alert-warning">
                                                        <strong th:text="${horario.curso.nombre}"></strong><br>
                                                        <small>
                                                            <span th:text="${horario.diaSemana}"></span> | 
                                                            <span th:text="${#temporals.format(horario.horaInicio, 'HH:mm')}"></span> - 
                                                            <span th:text="${#temporals.format(horario.horaFin, 'HH:mm')}"></span>
                                                        </small>
                                                    </div>
                                                    <p class="text-danger">
                                                        <small>
                                                            <i class="fas fa-info-circle me-1"></i>
                                                            Esta acción no se puede deshacer.
                                                        </small>
                                                    </p>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                    <form th:action="@{/horarios/eliminar/{id}(id=${horario.idHorario})}" method="post">
                                                        <button type="submit" class="btn btn-danger">Eliminar Horario</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Navegación -->
        <div class="mt-4 d-flex justify-content-between">
            <a th:href="@{/cursos}" class="btn btn-secondary btn-custom">
                <i class="fas fa-arrow-left me-2"></i>Volver a Cursos
            </a>
            <a th:href="@{/horarios/nuevo}" class="btn btn-success btn-custom">
                <i class="fas fa-plus me-2"></i>Nuevo Horario
            </a>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Auto-dismiss alerts after 5 seconds
        setTimeout(function() {
            var alerts = document.querySelectorAll('.alert');
            alerts.forEach(function(alert) {
                var bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);

        // Tooltip initialization
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[title]'));
        var tooltipList = tooltipTriggerList.map(function(tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });
    </script>
</body>
</html>