<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Sistema McAulley</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary-color: #4361ee;
            --secondary-color: #3f37c9;
            --success-color: #4cc9f0;
            --warning-color: #f72585;
            --info-color: #4895ef;
        }
        
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        .container {
            max-width: 1400px;
        }
        
        /* Header Styles */
        .page-header {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            color: white;
            border-radius: 15px;
            padding: 2rem;
            margin-bottom: 2rem;
            box-shadow: 0 10px 30px rgba(67, 97, 238, 0.3);
        }
        
        .page-header h1 {
            font-weight: 700;
            margin-bottom: 0.5rem;
            font-size: 2.5rem;
        }
        
        .stats-text {
            font-size: 1.1rem;
            opacity: 0.9;
        }
        
        /* Card Styles */
        .dashboard-card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
            margin-bottom: 1.5rem;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            overflow: hidden;
        }
        
        .dashboard-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        }
        
        .card-header {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            border-bottom: 2px solid #e9ecef;
            border-radius: 15px 15px 0 0 !important;
            padding: 1.25rem 1.5rem;
            font-weight: 600;
        }
        
        .card-header h5 {
            margin: 0;
            color: var(--primary-color);
        }
        
        /* Stat Cards */
        .stat-card {
            border: none;
            border-radius: 15px;
            color: white;
            padding: 1.5rem;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        
        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.05) 100%);
        }
        
        .stat-card.primary {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
        }
        
        .stat-card.success {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        }
        
        .stat-card.warning {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        }
        
        .stat-card.info {
            background: linear-gradient(135deg, var(--info-color) 0%, #2563eb 100%);
        }
        
        .stat-number {
            font-size: 2.5rem;
            font-weight: bold;
            margin-bottom: 0.5rem;
        }
        
        .stat-icon {
            font-size: 2.5rem;
            opacity: 0.8;
            margin-bottom: 1rem;
        }
        
        /* Quick Actions */
        .quick-action {
            background: white;
            border-radius: 15px;
            padding: 1.5rem;
            text-align: center;
            transition: all 0.3s ease;
            border: 2px solid transparent;
            height: 100%;
        }
        
        .quick-action:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
            border-color: var(--primary-color);
            text-decoration: none;
        }
        
        .quick-action-icon {
            font-size: 2.5rem;
            margin-bottom: 1rem;
            display: block;
        }
        
        .quick-action.primary .quick-action-icon { color: var(--primary-color); }
        .quick-action.success .quick-action-icon { color: #10b981; }
        .quick-action.warning .quick-action-icon { color: #f59e0b; }
        .quick-action.info .quick-action-icon { color: var(--info-color); }
        
        /* Activity List */
        .activity-list .list-group-item {
            border: none;
            border-bottom: 1px solid #f1f3f4;
            padding: 1rem 1.25rem;
            transition: background-color 0.3s ease;
        }
        
        .activity-list .list-group-item:last-child {
            border-bottom: none;
        }
        
        .activity-list .list-group-item:hover {
            background-color: #f8f9fa;
        }
        
        .activity-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 1rem;
        }
        
        .activity-icon.success {
            background: linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%);
            color: #065f46;
        }
        
        .activity-icon.warning {
            background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
            color: #92400e;
        }
        
        .activity-icon.info {
            background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
            color: #1e40af;
        }
        
        .activity-icon.primary {
            background: linear-gradient(135deg, #e0e7ff 0%, #c7d2fe 100%);
            color: var(--primary-color);
        }
        
        /* Navigation */
        .navbar {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%) !important;
            box-shadow: 0 4px 15px rgba(67, 97, 238, 0.3);
        }
        
        .navbar-brand {
            font-weight: 700;
            font-size: 1.5rem;
        }
        
        /* Footer */
        footer {
            background: linear-gradient(135deg, #1f2937 0%, #111827 100%);
            margin-top: 3rem;
        }
        
        /* Badge Styles */
        .badge {
            border-radius: 20px;
            padding: 0.5rem 1rem;
            font-weight: 600;
            font-size: 0.75rem;
        }
        
        /* Responsive */
        @media (max-width: 768px) {
            .page-header {
                padding: 1.5rem;
                text-align: center;
            }
            
            .page-header h1 {
                font-size: 2rem;
            }
            
            .stat-number {
                font-size: 2rem;
            }
            
            .quick-action {
                margin-bottom: 1rem;
            }
        }
    </style>
</head>
<body>
    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" th:href="@{/}">
                <i class="fas fa-graduation-cap me-2"></i>
                Sistema McAulley
            </a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link" th:href="@{/}"><i class="fas fa-home me-1"></i>Inicio</a>
                <a class="nav-link" th:href="@{/menu}"><i class="fas fa-bars me-1"></i>Menú Principal</a>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <!-- Welcome Section -->
        <div class="page-header">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1>Bienvenido al Sistema McAulley</h1>
                    <p class="stats-text mb-0">Panel de control para la gestión integral de alumnas, cursos e inscripciones</p>
                </div>
                <div class="col-md-4 text-end">
                    <i class="fas fa-chart-line fa-4x opacity-75"></i>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="row mb-4">
            <div class="col-md-12">
                <h3 class="mb-3"><i class="fas fa-bolt me-2 text-warning"></i>Acciones Rápidas</h3>
                <div class="row g-3">
                    <div class="col-xl-3 col-md-6">
                        <a th:href="@{/alumnas}" class="text-decoration-none">
                            <div class="quick-action primary">
                                <i class="fas fa-users quick-action-icon"></i>
                                <h5 class="fw-bold">Gestión de Alumnas</h5>
                                <p class="text-muted mb-0">Administrar estudiantes del sistema</p>
                                <span class="badge bg-primary mt-2">Ver listado</span>
                            </div>
                        </a>
                    </div>
                    <div class="col-xl-3 col-md-6">
                        <a th:href="@{/cursos}" class="text-decoration-none">
                            <div class="quick-action success">
                                <i class="fas fa-book quick-action-icon"></i>
                                <h5 class="fw-bold">Gestión de Cursos</h5>
                                <p class="text-muted mb-0">Administrar catálogo de cursos</p>
                                <span class="badge bg-success mt-2">Ver listado</span>
                            </div>
                        </a>
                    </div>
                    <div class="col-xl-3 col-md-6">
                        <a th:href="@{/cursos/nuevo}" class="text-decoration-none">
                            <div class="quick-action warning">
                                <i class="fas fa-plus-circle quick-action-icon"></i>
                                <h5 class="fw-bold">Nuevo Curso</h5>
                                <p class="text-muted mb-0">Crear nuevo curso en el sistema</p>
                                <span class="badge bg-warning mt-2">Crear</span>
                            </div>
                        </a>
                    </div>
                    <div class="col-xl-3 col-md-6">
                        <a th:href="@{/inscripciones/nuevo}" class="text-decoration-none">
                            <div class="quick-action info">
                                <i class="fas fa-user-plus quick-action-icon"></i>
                                <h5 class="fw-bold">Nueva Inscripción</h5>
                                <p class="text-muted mb-0">Inscribir alumna en curso</p>
                                <span class="badge bg-info mt-2">Inscribir</span>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Statistics -->
        <div class="row mb-4">
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="stat-card primary">
                    <i class="fas fa-users stat-icon"></i>
                    <div class="stat-number" th:text="${totalAlumnas ?: '0'}">0</div>
                    <h5>Total Alumnas</h5>
                    <small class="opacity-75" th:if="${alumnasActivas != null}" 
                           th:text="'Activas: ' + ${alumnasActivas}"></small>
                </div>
            </div>
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="stat-card success">
                    <i class="fas fa-book stat-icon"></i>
                    <div class="stat-number" th:text="${totalCursos ?: '0'}">0</div>
                    <h5>Total Cursos</h5>
                    <small class="opacity-75" th:if="${cursosActivos != null}" 
                           th:text="'Activos: ' + ${cursosActivos}"></small>
                </div>
            </div>
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="stat-card warning">
                    <i class="fas fa-play-circle stat-icon"></i>
                    <div class="stat-number" th:text="${cursosActivos ?: '0'}">0</div>
                    <h5>Cursos Activos</h5>
                    <small class="opacity-75" th:if="${totalCursos != null && cursosActivos != null}" 
                           th:text="${#numbers.formatDecimal((cursosActivos / totalCursos) * 100, 1, 1)} + '% del total'"></small>
                </div>
            </div>
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="stat-card info">
                    <i class="fas fa-user-graduate stat-icon"></i>
                    <div class="stat-number" th:text="${totalInscripciones ?: '0'}">0</div>
                    <h5>Total Inscripciones</h5>
                    <small class="opacity-75" th:if="${inscripcionesActivas != null}" 
                           th:text="'Activas: ' + ${inscripcionesActivas}"></small>
                </div>
            </div>
        </div>

        <!-- Recent Activity and Upcoming Tasks -->
        <div class="row">
            <div class="col-xl-6 mb-4">
                <div class="card dashboard-card">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="fas fa-clock me-2 text-primary"></i>Actividad Reciente</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="activity-list list-group list-group-flush">
                            <div class="list-group-item d-flex align-items-center">
                                <div class="activity-icon success">
                                    <i class="fas fa-user-plus"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-semibold">Nueva alumna registrada</div>
                                    <small class="text-muted">María González se unió al sistema</small>
                                </div>
                                <small class="text-muted">Hace 2 horas</small>
                            </div>
                            <div class="list-group-item d-flex align-items-center">
                                <div class="activity-icon warning">
                                    <i class="fas fa-book"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-semibold">Curso actualizado</div>
                                    <small class="text-muted">Programación Web - Nuevo horario agregado</small>
                                </div>
                                <small class="text-muted">Hace 5 horas</small>
                            </div>
                            <div class="list-group-item d-flex align-items-center">
                                <div class="activity-icon info">
                                    <i class="fas fa-check-circle"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-semibold">Inscripción completada</div>
                                    <small class="text-muted">Ana López en Diseño Gráfico</small>
                                </div>
                                <small class="text-muted">Ayer</small>
                            </div>
                            <div class="list-group-item d-flex align-items-center">
                                <div class="activity-icon primary">
                                    <i class="fas fa-chart-bar"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-semibold">Reporte generado</div>
                                    <small class="text-muted">Estadísticas mensuales del sistema</small>
                                </div>
                                <small class="text-muted">Hace 2 días</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-6 mb-4">
                <div class="card dashboard-card">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="fas fa-tasks me-2 text-success"></i>Próximas Actividades</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="activity-list list-group list-group-flush">
                            <div class="list-group-item d-flex align-items-center">
                                <div class="activity-icon primary">
                                    <i class="fas fa-calendar-check"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-semibold">Revisión de inscripciones</div>
                                    <small class="text-muted">Verificar inscripciones pendientes de aprobación</small>
                                </div>
                                <span class="badge bg-primary">Próximos 2 días</span>
                            </div>
                            <div class="list-group-item d-flex align-items-center">
                                <div class="activity-icon warning">
                                    <i class="fas fa-bell"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-semibold">Inicio de cursos</div>
                                    <small class="text-muted">3 cursos nuevos inician esta semana</small>
                                </div>
                                <span class="badge bg-warning">Esta semana</span>
                            </div>
                            <div class="list-group-item d-flex align-items-center">
                                <div class="activity-icon info">
                                    <i class="fas fa-chart-line"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-semibold">Reporte mensual</div>
                                    <small class="text-muted">Generar reporte de actividades del mes</small>
                                </div>
                                <span class="badge bg-info">Fin de mes</span>
                            </div>
                            <div class="list-group-item d-flex align-items-center">
                                <div class="activity-icon success">
                                    <i class="fas fa-graduation-cap"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-semibold">Ceremonia de graduación</div>
                                    <small class="text-muted">Preparar evento de finalización de cursos</small>
                                </div>
                                <span class="badge bg-success">Próximo mes</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Additional Quick Links -->
        <div class="row mt-2">
            <div class="col-md-12">
                <div class="card dashboard-card">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="fas fa-compass me-2 text-info"></i>Accesos Directos</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <a th:href="@{/horarios}" class="btn btn-outline-primary w-100 d-flex align-items-center justify-content-center py-3">
                                    <i class="fas fa-clock me-3 fa-lg"></i>
                                    <div class="text-start">
                                        <div class="fw-bold">Horarios</div>
                                        <small class="text-muted">Gestión de horarios</small>
                                    </div>
                                </a>
                            </div>
                            <div class="col-md-4">
                                <a th:href="@{/inscripciones}" class="btn btn-outline-success w-100 d-flex align-items-center justify-content-center py-3">
                                    <i class="fas fa-user-graduate me-3 fa-lg"></i>
                                    <div class="text-start">
                                        <div class="fw-bold">Inscripciones</div>
                                        <small class="text-muted">Ver todas las inscripciones</small>
                                    </div>
                                </a>
                            </div>
                            <div class="col-md-4">
                                <a th:href="@{/menu}" class="btn btn-outline-warning w-100 d-flex align-items-center justify-content-center py-3">
                                    <i class="fas fa-bars me-3 fa-lg"></i>
                                    <div class="text-start">
                                        <div class="fw-bold">Menú Completo</div>
                                        <small class="text-muted">Todas las opciones del sistema</small>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="py-4 mt-5">
        <div class="container text-center">
            <p class="mb-0 text-white opacity-75">
                &copy; 2024 Sistema Educativo McAulley. Todos los derechos reservados.
            </p>
            <small class="text-white opacity-50">
                <i class="fas fa-heart text-danger mx-1"></i>
                Desarrollado con tecnología educativa avanzada
            </small>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Simple animation for stat cards
        document.addEventListener('DOMContentLoaded', function() {
            const statCards = document.querySelectorAll('.stat-card');
            statCards.forEach((card, index) => {
                setTimeout(() => {
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                }, index * 100);
            });
        });
    </script>
</body>
</html>